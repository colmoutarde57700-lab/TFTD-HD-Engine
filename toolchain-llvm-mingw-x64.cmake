set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_CL_64 TRUE)
set(TOOLROOT "$ENV{LLVM_MINGW_ROOT}" CACHE PATH "LLVM-MinGW UCRT root")
if(NOT EXISTS "${TOOLROOT}/bin")
  message(FATAL_ERROR "Set LLVM_MINGW_ROOT or pass -DTOOLROOT=/path/to/llvm-mingw")
endif()
if(CMAKE_HOST_WIN32)
  set(TOOL_EXE ".exe")
else()
  set(TOOL_EXE "")
endif()
set(CMAKE_C_COMPILER "${TOOLROOT}/bin/x86_64-w64-mingw32-clang${TOOL_EXE}")
set(CMAKE_CXX_COMPILER "${TOOLROOT}/bin/x86_64-w64-mingw32-clang++${TOOL_EXE}")
set(CMAKE_RC_COMPILER "${TOOLROOT}/bin/x86_64-w64-mingw32-windres${TOOL_EXE}")
set(CMAKE_AR "${TOOLROOT}/bin/llvm-ar${TOOL_EXE}")
set(CMAKE_RANLIB "${TOOLROOT}/bin/llvm-ranlib${TOOL_EXE}")
set(CMAKE_FIND_ROOT_PATH "${TOOLROOT}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
